# Copy to .env and fill in. .env is git-ignored and is not copied into the Docker image.
# On Hugging Face, set these as Space *secrets* instead (Settings -> Variables and secrets).

# Sawtak Arabi TTS key for the model-answer playback (https://sawtakarabi.ai/dashboard).
# Without it the page falls back to the device's Arabic voice.
SAWTAK_API_KEY=

# Optional: a specific voice id from the Sawtak catalog.
# Empty = the most liked ready Palestinian voice.
SAWTAK_VOICE_ID=

# Google sign-in through Supabase (Project Settings -> API Keys). Both values are public: the page gets them too.
# Empty = no sign-in, the service is open. On Hugging Face these can be plain Space *variables*.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional: the teacher's account (or several, separated by commas or spaces). After sign-in a teacher chooses
# between "תרגול" (the same as a student) and "ניהול" (the management panel: every student's progress, and the
# classes). Who may sign in is set by the classes the teacher opens there (see the README), not here.
TEACHER_EMAILS=

# Needed by the management panel and the classes: the project's secret key (Project Settings -> API Keys -> secret, or the
# legacy service_role key). It reads every student's rows, so it is NOT public: on Hugging Face set it as a *secret*.
SUPABASE_SECRET_KEY=
